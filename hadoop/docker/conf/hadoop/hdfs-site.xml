<?xml version="1.0"?>
<!-- AI citation: Claude Code (Claude Opus 5.5, Anthropic) drafted this config. Reviewed and tested by Member 1. -->
<configuration>
  <!-- Set explicitly (spec requirement). Replication factor 2 with 3 DataNodes means that
       losing one DataNode leaves every block with at least one copy, and the third node
       gives HDFS somewhere to re-replicate to. -->
  <property>
    <name>dfs.replication</name>
    <value>2</value>
  </property>
  <!-- Block size 32 MB, set explicitly. A GDELT daily file is about 51 MB unzipped, so each
       file spans 2 blocks and gets 2 input splits. That gives fsck and the locality counters
       something to show on a one-month sample. -->
  <property>
    <name>dfs.blocksize</name>
    <value>33554432</value>
  </property>

  <property>
    <name>dfs.namenode.name.dir</name>
    <value>file:///data/nn</value>
  </property>
  <property>
    <name>dfs.datanode.data.dir</name>
    <value>file:///data/dn</value>
  </property>
  <property>
    <name>dfs.namenode.rpc-bind-host</name>
    <value>0.0.0.0</value>
  </property>
  <property>
    <name>dfs.namenode.http-address</name>
    <value>0.0.0.0:9870</value>
  </property>
  <property>
    <name>dfs.permissions.enabled</name>
    <value>false</value>
  </property>
  <property>
    <name>dfs.namenode.datanode.registration.ip-hostname-check</name>
    <value>false</value>
  </property>

  <!-- Faster dead-node detection for the fault-tolerance demo.
       Dead after 2 * recheck + 10 * heartbeat = 2*30 s + 10*3 s = 90 s (default is about 10.5 min). -->
  <property>
    <name>dfs.heartbeat.interval</name>
    <value>3</value>
  </property>
  <property>
    <name>dfs.namenode.heartbeat.recheck-interval</name>
    <value>30000</value>
  </property>
</configuration>
